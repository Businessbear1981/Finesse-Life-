# Backend env. Set in Railway → Variables.

PORT=8000
FRONTEND_URL=http://localhost:3000

# Supabase (use SERVICE_ROLE on the backend so RLS can be bypassed when needed)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Anthropic (only if backend runs agents)
ANTHROPIC_API_KEY=

# LangSmith (only if tracing agents)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=true
