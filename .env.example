# Copy to .env.local and fill in. Never commit this file with values.
# NEXT_PUBLIC_* is bundled into the client. Everything else is server-only.
#
# Schema mirrors Sean's canonical multi-vendor stack (Supabase + Cloudflare R2
# + Porkbun DNS + Railway). Remove the blocks you don't need.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://finesselife.vip
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase (auth + DB) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Cloudflare R2 (object storage; NOT used for DNS) ------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_TOKEN=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Porkbun (domain DNS) ---------------------------------------------------
# Sean's projects typically use Porkbun for DNS, not Cloudflare.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# --- Railway (backend service) ----------------------------------------------
RAILWAY_PROJECT_ID=
RAILWAY_TOKEN=

# --- AI media generation (always include — app-in-a-box capability) ----------
# Voice / TTS — ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
# Image + short video — Higgsfield
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai/v1
# 3D — Meshy
MESHY_API_KEY=
# Music — Suno
SUNO_API_KEY=
SUNO_API_BASE=https://api.sunoapi.com/v1

# --- Cloud AI access (default: Vercel AI Gateway) ---------------------------
# Unified endpoint for Claude / GPT / Gemini / Llama. Swap models by string.
# Get from: vercel.com/dashboard → AI → AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# Optional direct provider keys (only if bypassing the gateway)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agent observability (only if the project has LLM agents) ----------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finesselife.app
LANGSMITH_TRACING=true


# --- KeyLocks (server-only — never NEXT_PUBLIC_) -----------------------------
# Signing secret for the entrance + private-lift locks. >= 32 chars. Required.
KEYLOCK_SECRET=
# Six-digit public entrance code. Unset => honest preview mode (any code opens, UI says so).
ENTRANCE_KEYLOCK_CODE=
# Backstage KeyLock / Vault cipher key (no fallback; routes fail closed without it).
INTEGRATIONS_ENCRYPTION_KEY=

# --- Vault (frozen until card partner + economics are signed off) ------------
VAULT_LEDGER_WRITES_ENABLED=false
# Approved cashback in basis points (100 = 1%). Required when writes are enabled.
VAULT_CASHBACK_RATE_BPS=

# --- Migrations (shell only, never commit) ----------------------------------
# SUPABASE_DB_PASSWORD is read by scripts/migrate.js

# ── AI token usage ledger (settings/ai-usage + Obsidian export) ──
# Long random token (>= 32 chars) for read-only GET /api/admin/ai-usage. Generate: openssl rand -hex 32
AI_USAGE_EXPORT_TOKEN=
# Optional list-price overrides, USD per 1M tokens:
# AI_PRICING_JSON={"claude-sonnet":{"in":3,"out":15,"cacheRead":0.3,"cacheWrite":3.75}}
AI_PRICING_JSON=
