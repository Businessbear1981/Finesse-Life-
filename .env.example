# Copy to .env.local and fill in. Never commit this file with values.
# NEXT_PUBLIC_* is bundled into the client. Everything else is server-only.
#
# Schema mirrors Sean's canonical multi-vendor stack (Supabase + Cloudflare R2
# + Porkbun DNS). Remove the blocks you don't need.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://finesselife.app

# Demo theater switch (src/lib/demo.ts). Defaults to true (demo content shown:
# placeholder market listings, 123456 entrance PIN). Set to false for a
# real-data build. Build-time flag — changing it requires a redeploy.
NEXT_PUBLIC_DEMO_MODE=true
# Real entrance PIN. If unset with demo mode off, the vault door stays locked.
NEXT_PUBLIC_ENTRANCE_PIN=

# --- Supabase (auth + DB) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Cloudflare R2 (object storage; NOT used for DNS) ------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_TOKEN=
R2_BUCKET=
R2_PUBLIC_URL=

# --- Porkbun (domain DNS) ---------------------------------------------------
# Sean's projects typically use Porkbun for DNS, not Cloudflare.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=

# --- AI media generation (always include — app-in-a-box capability) ----------
# Voice / TTS — ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
# Image + short video — Higgsfield
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_API_BASE=https://platform.higgsfield.ai/v1
# 3D — Meshy
MESHY_API_KEY=
# Music — Suno
SUNO_API_KEY=
SUNO_API_BASE=https://api.sunoapi.com/v1

# --- Cloud AI access (default: Vercel AI Gateway) ---------------------------
# Unified endpoint for Claude / GPT / Gemini / Llama. Swap models by string.
# Get from: vercel.com/dashboard → AI → AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# Optional direct provider keys (only if bypassing the gateway)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agent observability (only if the project has LLM agents) ----------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finesselife.app
LANGSMITH_TRACING=true

