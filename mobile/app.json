{
  "expo": {
    "name": "Finesse Life",
    "slug": "finesse-life",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finesse",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#080406"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17090D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Finesse uses the microphone in Starmaker to record your vocals, takes and podcasts. Recordings stay on your device unless you choose to share them."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Finesse lets you choose photos to send to your stylist.",
          "cameraPermission": "Finesse uses the camera so you can photograph outfits and pieces for your stylist."
        }
      ],
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
